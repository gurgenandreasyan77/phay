# LOCAL development — Docker Compose settings (compose.yaml).
# Copy to `.env` (`make local-setup` does it). Only compose-level values live
# here: project name, host ports, database credentials.
# Laravel's own settings (APP_KEY, mail, AI key, Google...) are in api/.env,
# see api/.env.example. Production uses .env.prod (see .env.prod.example).

# Docker Compose project: prefix of containers and volumes (phay_postgres_data).
# Changing it starts a NEW empty database volume.
COMPOSE_PROJECT_NAME=phay

# Host ports. Change one if it is taken on your machine.
# The Servio site (other repo) expects the API on 8080.
ADMIN_PORT=3001
API_PORT=8080
POSTGRES_PORT=5432

# Local database. The password only protects your own machine; it is set
# when the volume is created, changing it later does not change the
# existing database.
POSTGRES_DB=phay
POSTGRES_USER=phay
POSTGRES_PASSWORD=change_me
