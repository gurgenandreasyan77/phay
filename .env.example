# Compose-level env vars — read by compose.yaml / compose.prod.yaml and
# injected into the backend/frontend/postgres containers. Copy this file to
# `.env` and fill in real values before running `docker compose up`.

COMPOSE_PROJECT_NAME=servio

# Host ports — change if they collide with another project on the same server.
FRONTEND_PORT=3000
ADMIN_PORT=3001
API_PORT=8080
POSTGRES_PORT=5432

# Database credentials.
POSTGRES_DB=servio
POSTGRES_USER=servio
POSTGRES_PASSWORD=change_me

# Laravel core settings.
APP_NAME=Servio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Rate limit on POST /api/v1/leads, per IP.
LEADS_RATE_LIMIT_PER_MINUTE=5

# Rate limit on POST /api/v1/admin/login, per IP.
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5

# Sign-in security (production; dev logs mail and SMS instead of sending).
# The first super admin: `php artisan platform:bootstrap you@servio.am`
# prints a one-time link — no admin password lives in any .env.
# Mail: any SMTP provider (Resend, Brevo, Postmark, Amazon SES...), with
# SPF/DKIM set up for the sending domain.
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@servio.am
MAIL_FROM_NAME=Servio
# SMS codes for phone confirmation: log | twilio.
SMS_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# 2FA is always required for platform staff; this also requires it for owners.
TWO_FACTOR_REQUIRED_FOR_OWNERS=true

# Production only (compose.prod.yaml); in development put it in servio-back/.env.
# AI assistant (AI օգնական) in each business's admin.
# Key from https://platform.claude.com/settings/keys — never commit it.
# Without a key the assistant page says it is not connected.
ANTHROPIC_API_KEY=
# Model and how deeply it thinks (low is fast and cheap enough for chat;
# medium for harder questions). claude-sonnet-5-5 costs half of Opus.
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low
# Requests a month per business are set per plan by the super admin
# (Platform → Plans). This is only for a business without a plan.
ASSISTANT_MONTHLY_LIMIT=30

# Google Calendar sync in the business calendar (read only).
# OAuth client "Web application" from https://console.cloud.google.com/apis/credentials
# — never commit the secret. The redirect URI must be registered there exactly.
# Without them the calendar says the sync is not set up yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://admin.example.com/api/admin/google/callback


# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public site URL — canonical links, sitemap, JSON-LD. Development can use
# localhost; in production this MUST be the real https:// domain and MUST be
# set before running `docker compose -f compose.prod.yaml build` — Next.js
# inlines NEXT_PUBLIC_* vars at build time, so setting it only for `up` has
# no effect (see docs/seo/technical-seo.md's "Production URL" section).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser-facing API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# This site's key from the admin (Սայտեր / Sites). Sent as X-Site-Key so
# the API serves this business's content. Empty = the default business.
NEXT_PUBLIC_SITE_KEY=

# Contact details shown site-wide — placeholders, replace before launch.
NEXT_PUBLIC_CONTACT_PHONE=+374 55 337633
NEXT_PUBLIC_CONTACT_EMAIL=info@servio.am
NEXT_PUBLIC_CONTACT_CITY=Yerevan, Armenia

# Optional — footer/contacts page only show a link when the var is set. These
# are only a fallback for the admin-managed contact channels (Settings →
# Contact channels in /admin) — once a channel of that type exists there, it
# takes priority over the matching env var below.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_VIBER_URL=

# Optional — Google Analytics only loads when set.
NEXT_PUBLIC_GA_ID=
# Optional — Google Tag Manager only loads when set.
NEXT_PUBLIC_GTM_ID=
# Optional — Search Console / Bing Webmaster HTML meta-tag verification codes.
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Local SEO / structured data — see docs/seo/local-seo.md for how each field
# is used and what to do before launch. All placeholders until confirmed.
NEXT_PUBLIC_LEGAL_NAME=Servio
NEXT_PUBLIC_BUSINESS_STREET=
NEXT_PUBLIC_BUSINESS_LOCALITY=Yerevan
NEXT_PUBLIC_BUSINESS_COUNTRY=AM
# Leave both blank until the business confirms exact coordinates — omitted
# from JSON-LD entirely when unset, rather than pointing to a wrong location.
NEXT_PUBLIC_BUSINESS_LAT=
NEXT_PUBLIC_BUSINESS_LNG=
NEXT_PUBLIC_HOURS_OPENS=09:00
NEXT_PUBLIC_HOURS_CLOSES=20:00
# Google Business Profile / Maps listing URL, once created.
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Admin app (servio-admin). ADMIN_URL is where /admin/* on the public site
# redirects to (production: https://admin.servio.am). REVALIDATE_SECRET lets
# the admin refresh the public site's cache after an edit — use a long random
# string in production (e.g. `openssl rand -hex 32`).
ADMIN_URL=http://localhost:3001
REVALIDATE_SECRET=change_me
