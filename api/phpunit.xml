<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Inside Docker, DB_* and friends are already set as real container
            environment variables (see compose.yaml), landing in $_SERVER at
            process start. Laravel's env() resolution reads $_SERVER ahead of
            $_ENV/getenv(), so <env> alone (which does not touch $_SERVER)
            is not enough to redirect tests to sqlite — every entry below
            needs a matching forced <server> value, or RefreshDatabase runs
            against — and wipes — the real Postgres dev database.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <!-- Owners' 2FA is tested on its own (SecureAuthTest); the other tests sign owners in without it. -->
        <env name="TWO_FACTOR_REQUIRED_FOR_OWNERS" value="false" force="true"/>
        <env name="SMS_DRIVER" value="log" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_HOST" value="" force="true"/>
        <env name="DB_PORT" value="" force="true"/>
        <env name="DB_USERNAME" value="" force="true"/>
        <env name="DB_PASSWORD" value="" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <!-- compose.yaml gives the backend the old site webhook for a one-time migration; tests start without one. -->
        <env name="SITE_REVALIDATE_URL" value="" force="true"/>
        <env name="REVALIDATE_SECRET" value="" force="true"/>
        <!-- A local api/.env may name an older default business; tests make their own. -->
        <env name="PLATFORM_DEFAULT_TENANT" value="phay" force="true"/>

        <server name="APP_ENV" value="testing" force="true"/>
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_HOST" value="" force="true"/>
        <server name="DB_PORT" value="" force="true"/>
        <server name="DB_USERNAME" value="" force="true"/>
        <server name="DB_PASSWORD" value="" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="SITE_REVALIDATE_URL" value="" force="true"/>
        <server name="REVALIDATE_SECRET" value="" force="true"/>
        <server name="PLATFORM_DEFAULT_TENANT" value="phay" force="true"/>
    </php>
</phpunit>
