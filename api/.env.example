APP_NAME=Servio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Overridden to pgsql/postgres/servio by compose.yaml when running in Docker.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=servio
# DB_USERNAME=servio
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@servio.am"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limit on POST /api/v1/leads, per IP.
LEADS_RATE_LIMIT_PER_MINUTE=5

# Rate limit on POST /api/v1/admin/login, per IP.
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5

# Sign-in security. There is no admin password in .env: create the first
# super admin with `php artisan platform:bootstrap you@servio.am`, which
# prints a one-time link. 2FA secrets are encrypted with APP_KEY: never
# change APP_KEY on a live database (rotate via APP_PREVIOUS_KEYS).
ADMIN_URL=http://localhost:3001
# Development: SMS codes are written to storage/logs/laravel.log (log driver),
# emails too (MAIL_MAILER=log above).
SMS_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWO_FACTOR_REQUIRED_FOR_OWNERS=true


# Business served when a request has no X-Site-Key header (and used by
# console commands and seeders). Created by the migrations.
PLATFORM_DEFAULT_TENANT=servio

# AI assistant (AI օգնական) in each business's admin.
# Key from https://platform.claude.com/settings/keys — never commit it.
# Without a key the assistant page says it is not connected.
ANTHROPIC_API_KEY=
# Model and how deeply it thinks (low is fast and cheap enough for chat;
# medium for harder questions). claude-sonnet-5-5 costs half of Opus.
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low
# Requests a month per business are set per plan by the super admin
# (Platform → Plans). This is only for a business without a plan.
ASSISTANT_MONTHLY_LIMIT=30

# Google Calendar sync in the business calendar (read only).
# OAuth client "Web application" from https://console.cloud.google.com/apis/credentials
# — never commit the secret. The redirect URI must be registered there exactly.
# Without them the calendar says the sync is not set up yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/admin/google/callback

# Days before a subscription ends that the business is warned (chat + banner).
PLATFORM_SUBSCRIPTION_WARN_DAYS=10
