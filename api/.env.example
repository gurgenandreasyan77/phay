# LOCAL development — Laravel settings of the API.
# Copy to api/.env (`make local-setup` does it, then fills APP_KEY).
# In Docker the container also gets APP_ENV, APP_DEBUG, APP_URL, ADMIN_URL,
# CORS_ALLOWED_ORIGINS and DB_* from compose.yaml (built from the ports and
# database in the root .env), so those lines here only matter when Laravel
# runs outside Docker (`php artisan serve`).
# Production does not read this file: see .env.prod.example in the root.

# ---- Application -------------------------------------------------------
APP_NAME=Phay
APP_ENV=local
# Generated by `make local-key` (php artisan key:generate). Encrypts 2FA
# secrets, Google tokens and site webhook secrets: keep the same key for the
# same database, or those can no longer be read.
APP_KEY=
APP_DEBUG=true
# Address of the API itself: links to uploaded files (/storage/...).
APP_URL=http://localhost:8080
# Old keys accepted for decryption after a key change (comma-separated).
# APP_PREVIOUS_KEYS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ---- Logs --------------------------------------------------------------
# storage/logs/laravel.log. Mail and SMS codes are written there too in dev.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database ----------------------------------------------------------
# Docker overrides these with pgsql/postgres and the root .env credentials.
# Outside Docker: sqlite (database/database.sqlite) or your own Postgres.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=phay
# DB_USERNAME=phay
# DB_PASSWORD=

# ---- Sessions, cache, queue, files ------------------------------------
# All in the database: no Redis needed. Nothing is queued today (site cache
# refresh is sent after the response), so no queue worker runs.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ---- Browsers and links -----------------------------------------------
# Origins allowed to call the API from a browser on top of the connected
# sites (their origins come from Platform → Sites automatically).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Where the admin app lives: links in invitation and password reset emails.
ADMIN_URL=http://localhost:3001

# Rate limits per IP and minute: POST /api/v1/leads and admin sign-in.
LEADS_RATE_LIMIT_PER_MINUTE=5
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5

# ---- Sign-in security --------------------------------------------------
# No admin password in any .env: the first super admin comes from
# `make local-bootstrap email=you@example.com`, which prints a one-time link.
# Dev: emails go to the log (MAIL_MAILER=log), SMS codes too (SMS_DRIVER=log).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@phay.am"
MAIL_FROM_NAME="${APP_NAME}"
SMS_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# 2FA is always required for platform staff; this also requires it for
# business owners. false is handy locally.
TWO_FACTOR_REQUIRED_FOR_OWNERS=true
# Optional, defaults shown:
# TWO_FACTOR_ISSUER=Phay            # name in the authenticator app
# INVITATION_TTL_MINUTES=4320       # invitation link, 72 h
# BOOTSTRAP_TTL_MINUTES=60          # platform:bootstrap link
# PASSWORD_RESET_TTL_MINUTES=60
# SANCTUM_EXPIRATION=10080          # admin session, minutes (7 days)

# ---- Platform ----------------------------------------------------------
# Business used by console commands and seeders when none is given.
# Created by the migrations.
PLATFORM_DEFAULT_TENANT=servio
# Days before a subscription ends that the business is warned.
PLATFORM_SUBSCRIPTION_WARN_DAYS=10

# ---- AI assistant (AI օգնական) ----------------------------------------
# Key from https://platform.claude.com/settings/keys — never commit it.
# Without a key the assistant page says it is not connected.
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 costs about half of Opus. Effort: low | medium | high.
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low
# ASSISTANT_MAX_TOKENS=8000
# Requests a month for a business without a plan (plans set their own).
ASSISTANT_MONTHLY_LIMIT=30

# ---- Google Calendar sync (read only) ---------------------------------
# OAuth client "Web application" from
# https://console.cloud.google.com/apis/credentials. The redirect URI must be
# registered there exactly. Empty: the calendar says sync is not set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/admin/google/callback
