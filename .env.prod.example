# PRODUCTION — everything Phay needs on the server, in one file.
# On the server: `make prod-init` copies this to .env.prod and fills APP_KEY
# and POSTGRES_PASSWORD. Then edit the rest. Never commit .env.prod.
# Every key here reaches Laravel (compose.prod.yaml: env_file), so any
# Laravel setting from api/.env.example can be added here too.
# How to get each value: docs/DEPLOY.md, section "Переменные .env.prod".

# ---- Docker Compose ----------------------------------------------------
# Other name than local (phay), so a prod stack started on a dev machine
# never touches the local database volume.
COMPOSE_PROJECT_NAME=phay-prod
# Published on 127.0.0.1 only: the host nginx proxies to them.
API_PORT=8081
ADMIN_PORT=3001

# ---- Database (container postgres, never published) -------------------
POSTGRES_DB=phay
POSTGRES_USER=phay
# Required. `make prod-init` puts a random one. Set before the first start:
# Postgres keeps the password the volume was created with.
POSTGRES_PASSWORD=

# ---- Application -------------------------------------------------------
APP_NAME=Phay
# Required. `make prod-init` generates it (or `make prod-key`). Back it up
# apart from the database: 2FA secrets, Google tokens and site webhook
# secrets are encrypted with it. Never change it on a live database.
APP_KEY=
# The API's public address: links to uploaded files.
APP_URL=https://api.phay.am
# Where the admin app lives: links in invitation and reset emails.
ADMIN_URL=https://app.phay.am
# Browser origins on top of connected sites (those come from Platform → Sites).
CORS_ALLOWED_ORIGINS=https://app.phay.am
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ---- Logs (volume app_logs, `make prod-logs-app`) ---------------------
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info

# Rate limits per IP and minute: lead form and admin sign-in.
LEADS_RATE_LIMIT_PER_MINUTE=5
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5

# ---- Mail (invitations, password resets, sign-in notices) -------------
# Any SMTP: Resend (smtp.resend.com, user "resend", password = API key),
# Brevo, Postmark, Amazon SES... The sending domain needs SPF and DKIM.
MAIL_MAILER=smtp
# smtp (STARTTLS on 587) or smtps (TLS on 465).
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@phay.am
MAIL_FROM_NAME=Phay

# ---- SMS codes (phone confirmation) -----------------------------------
# log = codes only in the log (no SMS); twilio = real SMS.
SMS_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Number or Messaging Service sender from Twilio, e.g. +12025550123.
TWILIO_FROM=

# ---- Sign-in security --------------------------------------------------
# 2FA is always required for platform staff; this requires it for owners too.
TWO_FACTOR_REQUIRED_FOR_OWNERS=true
TWO_FACTOR_ISSUER=Phay

# ---- Platform ----------------------------------------------------------
PLATFORM_DEFAULT_TENANT=servio
PLATFORM_SUBSCRIPTION_WARN_DAYS=10

# ---- AI assistant ------------------------------------------------------
# https://platform.claude.com/settings/keys (needs credit on the account).
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low
ASSISTANT_MONTHLY_LIMIT=30

# ---- Google Calendar sync ---------------------------------------------
# OAuth client "Web application"; register exactly this redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.phay.am/api/admin/google/callback
