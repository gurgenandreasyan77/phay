# Laravel API. The admin only calls it server-side (Server Components and
# Route Handlers), so the internal Docker hostname is enough.
NEXT_INTERNAL_API_URL=http://api/api/v1

# Where to tell the public site (servio-front) to refresh its cache after an
# admin edit, and the shared secret it checks. Must match REVALIDATE_SECRET
# in servio-front.
SITE_REVALIDATE_URL=http://frontend:3000/api/revalidate
REVALIDATE_SECRET=change_me
